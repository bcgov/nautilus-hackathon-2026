{% extends "base" %}

{% block content %}
  <h1 class="text-2xl font-semibold text-slate-900">Pipelines</h1>
  <p id="repo-info" class="mt-2 text-sm text-slate-600"></p>
  <form id="pipeline-form" class="mt-6 grid gap-4">
    <div>
      <label class="text-sm font-medium text-slate-700" for="pipeline-name">Name</label>
      <input
        class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
        id="pipeline-name"
        name="name"
        type="text"
        required
      />
    </div>
    <div>
      <label class="text-sm font-medium text-slate-700" for="pipeline-branch">Branch name</label>
      <input
        class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
        id="pipeline-branch"
        name="branch_name"
        type="text"
        required
      />
    </div>
    <label class="flex items-center gap-2 text-sm text-slate-700">
      <input id="auto-deploy" name="auto_deploy" type="checkbox" class="h-4 w-4 rounded border-slate-300" />
      Auto deploy
    </label>
    <button class="inline-flex w-fit items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" type="submit">
      Create Pipeline
    </button>
  </form>

  <table class="mt-8 w-full table-auto text-sm">
    <thead class="border-b border-slate-200 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Branch</th>
        <th>Auto Deploy</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="pipeline-table" class="divide-y divide-slate-100"></tbody>
  </table>

  <script>
    const tableBody = document.getElementById("pipeline-table");
    const form = document.getElementById("pipeline-form");
    const repoInfo = document.getElementById("repo-info");

    const repoId = {{ repo_id }};

    function isoNow() {
      return new Date().toISOString();
    }

    async function loadRepo() {
      const res = await fetch(`/repositories/${repoId}`);
      if (res.ok) {
        const repo = await res.json();
        repoInfo.textContent = `Repository: ${repo.name} (${repo.url})`;
      } else {
        repoInfo.textContent = "Repository not found.";
      }
    }

    async function loadPipelines() {
      const res = await fetch(`/repositories/${repoId}/pipelines`);
      const pipelines = await res.json();
      tableBody.innerHTML = "";
      pipelines.forEach((pipeline) => {
        const row = document.createElement("tr");
        row.innerHTML = `
          <td class="py-3">${pipeline.id}</td>
          <td class="py-3 font-medium text-slate-800">${pipeline.name}</td>
          <td class="py-3 text-slate-600">${pipeline.branch_name}</td>
          <td class="py-3">${pipeline.auto_deploy === 1 ? "Yes" : "No"}</td>
          <td class="py-3">
            <div class="flex flex-wrap gap-2">
              <a
                class="rounded-lg border border-slate-200 px-3 py-1 text-sm text-slate-700 hover:bg-slate-50"
                href="/app/repositories/${repoId}/pipelines/${pipeline.id}/edit"
              >Edit</a>
              <button
                data-id="${pipeline.id}"
                data-name="${pipeline.name}"
                class="delete-pipeline rounded-lg border border-rose-200 px-3 py-1 text-sm text-rose-600 hover:bg-rose-50"
              >Delete</button>
            </div>
          </td>
        `;
        row.querySelector(".delete-pipeline").addEventListener("click", async (event) => {
          event.preventDefault();
          const id = event.target.dataset.id;
          const name = event.target.dataset.name;
          showConfirm(`Delete pipeline ${name}?`, async (confirmed) => {
            if (!confirmed) {
              return;
            }
            const res = await fetch(`/repositories/${repoId}/pipelines/${id}`, { method: "DELETE" });
            if (!res.ok) {
              showMessage("Delete failed. Try again.", "error");
              return;
            }
            showMessage("Pipeline deleted.", "success");
            loadPipelines();
          });
        });
        tableBody.appendChild(row);
      });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const payload = {
        name: form.name.value,
        branch_name: document.getElementById("pipeline-branch").value,
        auto_deploy: form.auto_deploy.checked ? 1 : 0,
        created_at: isoNow(),
        updated_at: isoNow(),
      };
      const res = await fetch(`/repositories/${repoId}/pipelines`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        showMessage("Failed to create pipeline.", "error");
        return;
      }
      form.reset();
      showMessage("Pipeline created.", "success");
      loadPipelines();
    });

    loadRepo();
    loadPipelines();
  </script>
{% endblock content %}
