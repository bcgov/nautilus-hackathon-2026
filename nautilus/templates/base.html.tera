<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Nautilus</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex items-center gap-6 px-6 py-4">
        <a class="text-lg font-semibold text-slate-900" href="/">Nautilus</a>
      </div>
    </header>
    <main class="mx-auto px-6 py-8">
      <div class="rounded-2xl bg-white p-6 shadow-sm">
        <div id="app-message" class="mb-4 hidden rounded-lg border px-4 py-3 text-sm"></div>
        {% block content %}{% endblock content %}
      </div>
    </main>
    <div id="confirm-modal" class="fixed inset-0 hidden items-center justify-center bg-slate-900/50">
      <div class="w-full max-w-sm rounded-xl bg-white p-6 shadow-lg">
        <h2 class="text-lg font-semibold text-slate-900">Please confirm</h2>
        <p class="mt-2 text-sm text-slate-600" id="confirm-text"></p>
        <div class="mt-4 flex justify-end gap-3">
          <button id="confirm-cancel" class="rounded-lg border border-slate-200 px-3 py-1 text-sm text-slate-700 hover:bg-slate-50">Cancel</button>
          <button id="confirm-ok" class="rounded-lg bg-rose-600 px-3 py-1 text-sm text-white hover:bg-rose-700">Delete</button>
        </div>
      </div>
    </div>
    <script>
      const messageEl = document.getElementById("app-message");

      window.showMessage = (text, type) => {
        if (!messageEl) {
          return;
        }
        messageEl.textContent = text;
        messageEl.classList.remove(
          "hidden",
          "border-rose-200",
          "text-rose-700",
          "bg-rose-50",
          "border-emerald-200",
          "text-emerald-700",
          "bg-emerald-50"
        );
        if (type === "error") {
          messageEl.classList.add("border-rose-200", "text-rose-700", "bg-rose-50");
        } else {
          messageEl.classList.add("border-emerald-200", "text-emerald-700", "bg-emerald-50");
        }
      };

      const confirmModal = document.getElementById("confirm-modal");

      window.showConfirm = (message, onDone) => {
        if (!confirmModal) {
          onDone(false);
          return;
        }
        const textEl = confirmModal.querySelector("#confirm-text");
        const cancelBtn = confirmModal.querySelector("#confirm-cancel");
        const okBtn = confirmModal.querySelector("#confirm-ok");

        textEl.textContent = message;
        confirmModal.classList.remove("hidden");
        confirmModal.classList.add("flex");

        const cleanup = () => {
          confirmModal.classList.add("hidden");
          confirmModal.classList.remove("flex");
          cancelBtn.onclick = null;
          okBtn.onclick = null;
        };

        cancelBtn.onclick = () => {
          cleanup();
          onDone(false);
        };
        okBtn.onclick = () => {
          cleanup();
          onDone(true);
        };
      };
    </script>
  </body>
</html>
