{% extends "base" %}

{% block content %}
  <h1 class="text-2xl font-semibold text-slate-900">Edit Pipeline</h1>
  <p class="mt-2 text-sm text-slate-600">
    Update the pipeline details and save your changes.
  </p>
  <form id="pipeline-edit-form" class="mt-6 grid gap-4">
    <div>
      <label class="text-sm font-medium text-slate-700" for="pipeline-name">Name</label>
      <input
        class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none"
        id="pipeline-name"
        name="name"
        type="text"
        required
      />
    </div>
    <label class="flex items-center gap-2 text-sm text-slate-700">
      <input id="auto-deploy" name="auto_deploy" type="checkbox" class="h-4 w-4 rounded border-slate-300" />
      Auto deploy
    </label>
    <div class="flex items-center gap-3">
      <button class="inline-flex w-fit items-center rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700" type="submit">
        Save Changes
      </button>
      <a class="text-sm text-slate-600 hover:text-slate-900" href="/app/repositories/{{ repo_id }}/pipelines">Cancel</a>
    </div>
  </form>

  <script>
    const repoId = {{ repo_id }};
    const pipelineId = {{ pipeline_id }};
    const form = document.getElementById("pipeline-edit-form");
    const nameInput = document.getElementById("pipeline-name");
    const autoDeployInput = document.getElementById("auto-deploy");

    function isoNow() {
      return new Date().toISOString();
    }

    async function loadPipeline() {
      const res = await fetch(`/repositories/${repoId}/pipelines/${pipelineId}`);
      if (!res.ok) {
        window.location.href = `/app/repositories/${repoId}/pipelines`;
        return;
      }
      const pipeline = await res.json();
      nameInput.value = pipeline.name;
      autoDeployInput.checked = pipeline.auto_deploy === 1;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const payload = {
        name: nameInput.value,
        auto_deploy: autoDeployInput.checked ? 1 : 0,
        updated_at: isoNow(),
      };
      const res = await fetch(`/repositories/${repoId}/pipelines/${pipelineId}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        showMessage("Failed to update pipeline.", "error");
        return;
      }
      showMessage("Pipeline updated.", "success");
      window.location.href = `/app/repositories/${repoId}/pipelines`;
    });

    loadPipeline();
  </script>
{% endblock content %}
